Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 0.5
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/PointCloud2
      Name: FFS cloud
      Enabled: true
      Topic:
        Value: /ffs/points
        Depth: 1
        Reliability Policy: Reliable
        History Policy: Keep Last
        Durability Policy: Volatile
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Queue Size: 1
  Enabled: true
  Global Options:
    Fixed Frame: zed_left_arm_camera_link
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.0
      Distance: 2.0
      Pitch: 0.3
      Yaw: 3.14
Window Geometry:
  Width: 1400
  Height: 900
